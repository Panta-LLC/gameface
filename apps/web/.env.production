# Vite reads this file for `vite build` runs in production mode.
# These are placeholders — the real values are injected at docker build time
# via --build-arg from the deploy workflow (DOMAIN repo secret).
#
# If you build the web app outside the deploy workflow, set these explicitly:
#   VITE_API_URL=https://your-domain/api
#   VITE_SIGNALING_URL=wss://your-domain/signaling
#
# For local production-style builds against a local backend, override per-shell
# rather than committing real values here.

VITE_API_URL=http://localhost:3000
VITE_SIGNALING_URL=ws://localhost:3001
