# Phase 1: TLS via Let's Encrypt.
#
# DOMAIN must be set in the container environment (rendered from the GitHub
# Actions DOMAIN secret by the deploy workflow). LETSENCRYPT_EMAIL is
# optional; defaults to an anonymous LE account if unset.
#
# Routing:
#   /api/*       -> api:3000      (path prefix stripped, so /api/health -> /health)
#   /signaling   -> signaling:3001 (WebSocket upgrade)
#   /healthz     -> Caddy itself, for uptime probes
#   everything else -> web:80     (nginx serving the Vite build)
#
# HTTP -> HTTPS redirect is automatic when a domain is configured.

{
	email {$LETSENCRYPT_EMAIL:admin@example.com}
}

{$DOMAIN} {
	encode zstd gzip

	respond /healthz 200 {
		body "ok"
		close
	}

	handle_path /api/* {
		reverse_proxy api:3000
	}

	# WebSocket signaling. Caddy auto-handles Upgrade headers.
	handle /signaling* {
		reverse_proxy signaling:3001
	}

	handle {
		reverse_proxy web:80
	}
}
